// Configuração do Cloudflare: publica a pasta do site como páginas estáticas.
// O worker.js só roda para arquivos .mp4 (entrega o vídeo em pedaços, 206, que o iPhone exige).
{
  "name": "laritedeschi-site",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/*.mp4"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
